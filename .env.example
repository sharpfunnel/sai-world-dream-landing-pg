# Neon connection string — Neon dashboard > Connection Details > "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full"

# Admin dashboard (/admin) auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Meta Ads integration (Phase 5) — from a Meta developer app with the Marketing API
# product added. App dashboard > Settings > Basic for the ID/secret. Redirect URI
# must be added to the app's "Valid OAuth Redirect URIs" exactly as below.
META_APP_ID="replace-with-your-meta-app-id"
META_APP_SECRET="replace-with-your-meta-app-secret"
META_REDIRECT_URI="https://your-domain.com/api/meta/oauth/callback"
# Optional — pins the Graph API version used for all Meta calls. Defaults to v21.0.
META_GRAPH_API_VERSION="v21.0"

# Meta Conversions API (Phase 7) — sends a server-side "Lead" event whenever a Lead
# row is created. Pixel ID is under Events Manager > Data Sources > your pixel > Settings.
# The pixel is also installed via GTM (GTM-W7MFGWFW) — this must be the SAME pixel ID,
# or the browser and server events land in two different datasets and never dedup.
META_PIXEL_ID="replace-with-your-meta-pixel-id"
# Same value as META_PIXEL_ID, exposed to the browser — used by src/lib/meta/pixel.ts
# to fire the dedup-paired Lead event. NEXT_PUBLIC_* is inlined at build time, so a
# change here requires a redeploy, not just a restart.
NEXT_PUBLIC_META_PIXEL_ID="replace-with-your-meta-pixel-id"
# Optional — a dedicated CAPI access token (Events Manager > Settings > Conversions API >
# "Generate access token"). If unset, falls back to a connected ad account's OAuth token.
META_CAPI_ACCESS_TOKEN=""
# Optional — from Events Manager > Test Events, lets you verify events land there before
# going live. Leave unset in production.
META_CAPI_TEST_EVENT_CODE=""

# Protects /api/cron/meta-sync from unauthenticated calls. Vercel Cron automatically
# sends this as `Authorization: Bearer $CRON_SECRET` when the env var is set.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET="replace-with-a-random-32-byte-base64-string"
